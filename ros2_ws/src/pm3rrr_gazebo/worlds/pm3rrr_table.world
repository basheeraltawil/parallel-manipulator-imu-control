<?xml version="1.0"?>
<sdf version="1.6">
  <world name="pm3rrr_table">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Small, stiff closed chain: 1 ms step and more solver iterations
         keep the loop-closure joints tight. -->
    <physics name="ode_1ms" type="ode" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>150</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp></constraints>
      </ode>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.32 -0.32 0.33 0 0.62 2.36</pose>
      </camera>
    </gui>
  </world>
</sdf>
