<?xml version="1.0"?>
<!--
  Planar 3-RRR parallel manipulator ("pm3rrr")
  =============================================
  Generated from the original SolidWorks design, see
  docs/learning/03_cad_to_urdf.md for the full step-by-step process.

  URDF can only describe kinematic TREES. A parallel robot is a closed chain,
  so we model:
    * a tree:  base -> leg_i motor -> leg_i elbow   (i = 1..3)
               leg1 distal -> platform               (leg1_platform_joint)
    * two loop-closure joints (leg2/leg3 distal -> platform) that only
      physics engines read (Gazebo <gazebo> block, MuJoCo equality).
  RViz shows the closed loop correctly because the kinematics node
  publishes consistent values for every tree joint.

  Arguments:
    use_gazebo        add gazebo plugins + loop closures       (default false)
    use_ros2_control  add the <ros2_control> block              (default false)
-->
<robot name="pm3rrr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="use_ros2_control" default="false"/>

  <xacro:include filename="$(find pm3rrr_description)/urdf/pm3rrr_macros.xacro"/>

  <!-- ===================== world anchor and base ===================== -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/base_plate.stl"/></geometry>
      <material name="pm_base"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/base_plate.stl"/></geometry>
    </collision>
    <xacro:inertial_from_yaml name="base_plate"/>
  </link>

  <!-- ============================ legs ================================ -->
  <xacro:pm_leg idx="1"/>
  <xacro:pm_leg idx="2"/>
  <xacro:pm_leg idx="3"/>

  <!-- ========================= moving platform ======================== -->
  <!-- platform_link frame sits on leg-1's platform joint C1 with the platform's
       orientation; the platform centre is at -c1 in this frame. -->
  <link name="platform_link">
    <visual>
      <origin xyz="${-c1x} ${-c1y} 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/visual/platform.stl"/></geometry>
      <material name="pm_platform"/>
    </visual>
    <collision>
      <origin xyz="${-c1x} ${-c1y} 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/collision/platform.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${-c1x + inertials['platform']['com'][0]} ${-c1y + inertials['platform']['com'][1]} ${inertials['platform']['com'][2]}" rpy="0 0 0"/>
      <mass value="${inertials['platform']['mass']}"/>
      <inertia ixx="${inertials['platform']['ixx']}" ixy="${inertials['platform']['ixy']}"
               ixz="${inertials['platform']['ixz']}" iyy="${inertials['platform']['iyy']}"
               iyz="${inertials['platform']['iyz']}" izz="${inertials['platform']['izz']}"/>
    </inertial>
  </link>

  <joint name="leg1_platform_joint" type="revolute">
    <parent link="leg1_distal_link"/>
    <child link="platform_link"/>
    <origin xyz="${l2} 0 ${link_t}" rpy="0 0 ${radians(geo['platform1_home_deg'])}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="0" velocity="20"/>
    <dynamics damping="${passive_damping}" friction="0.0"/>
  </joint>

  <!-- Platform centre (the "pose" x, y, phi of all the maths) -->
  <link name="platform_center"/>
  <joint name="platform_center_joint" type="fixed">
    <parent link="platform_link"/>
    <child link="platform_center"/>
    <origin xyz="${-c1x} ${-c1y} 0" rpy="0 0 0"/>
  </joint>

  <!-- Tool frame on the top surface of the platform -->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="platform_center"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${platform_t}" rpy="0 0 0"/>
  </joint>

  <!-- Second MPU6050 mounted under the platform (closed-loop orientation feedback) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="platform_center"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${platform_t + 0.002}" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg use_ros2_control)">
    <xacro:include filename="$(find pm3rrr_description)/urdf/pm3rrr.ros2_control.xacro"/>
    <xacro:pm_ros2_control/>
  </xacro:if>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find pm3rrr_description)/urdf/pm3rrr.gazebo.xacro"/>
    <xacro:pm_gazebo/>
  </xacro:if>

</robot>
