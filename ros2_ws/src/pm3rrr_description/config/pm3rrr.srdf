<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF of the planar 3-RRR parallel manipulator.
  GENERATED by tools/cad_to_urdf/step3_generate_srdf.py (3000 sampled poses).

  NOTE for MoveIt users: MoveIt plans for serial (tree) chains. For this
  closed-chain robot the "platform_motors" group is used for joint-space
  motions and named states, while Cartesian motions of the platform are
  generated by pm3rrr_core (analytic IK) - see docs/learning/12_ros2_architecture.md.
-->
<robot name="pm3rrr">

  <!-- the robot is bolted to the table -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <!-- ===== planning groups ===== -->
  <group name="platform_motors">
    <joint name="leg1_motor_joint"/>
    <joint name="leg2_motor_joint"/>
    <joint name="leg3_motor_joint"/>
  </group>
  <group name="leg1"><chain base_link="base_link" tip_link="leg1_distal_link"/></group>
  <group name="leg2"><chain base_link="base_link" tip_link="leg2_distal_link"/></group>
  <group name="leg3"><chain base_link="base_link" tip_link="leg3_distal_link"/></group>
  <group name="platform"><link name="platform_link"/><link name="platform_center"/><link name="tool0"/></group>

  <!-- ===== named states (motor joints; 0 = servo centre = home pose) ===== -->
  <group_state name="home" group="platform_motors">
    <joint name="leg1_motor_joint" value="0"/>
    <joint name="leg2_motor_joint" value="0"/>
    <joint name="leg3_motor_joint" value="0"/>
  </group_state>

  <end_effector name="platform_tool" parent_link="leg1_distal_link" group="platform" parent_group="leg1"/>

  <!-- ===== passive (non-actuated) joints of the closed chain ===== -->
  <passive_joint name="leg1_elbow_joint"/>
  <passive_joint name="leg2_elbow_joint"/>
  <passive_joint name="leg3_elbow_joint"/>
  <passive_joint name="leg1_platform_joint"/>

  <!-- ===== self-collision matrix ===== -->
  <disable_collisions link1="base_link" link2="leg1_distal_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="leg1_proximal_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="leg1_servo_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="leg2_distal_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="leg2_proximal_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="leg2_servo_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="leg3_distal_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="leg3_proximal_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="leg3_servo_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="leg1_proximal_link" reason="Adjacent"/>
  <disable_collisions link1="leg1_distal_link" link2="leg1_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="leg2_distal_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="leg2_proximal_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="leg2_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="leg3_distal_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="leg3_proximal_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_distal_link" link2="platform_link" reason="Adjacent"/>
  <disable_collisions link1="leg1_proximal_link" link2="leg1_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_proximal_link" link2="leg2_distal_link" reason="Never"/>
  <disable_collisions link1="leg1_proximal_link" link2="leg2_proximal_link" reason="Never"/>
  <disable_collisions link1="leg1_proximal_link" link2="leg2_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_proximal_link" link2="leg3_distal_link" reason="Never"/>
  <disable_collisions link1="leg1_proximal_link" link2="leg3_proximal_link" reason="Never"/>
  <disable_collisions link1="leg1_proximal_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_proximal_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg1_servo_link" link2="leg2_distal_link" reason="Never"/>
  <disable_collisions link1="leg1_servo_link" link2="leg2_proximal_link" reason="Never"/>
  <disable_collisions link1="leg1_servo_link" link2="leg2_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_servo_link" link2="leg3_distal_link" reason="Never"/>
  <disable_collisions link1="leg1_servo_link" link2="leg3_proximal_link" reason="Never"/>
  <disable_collisions link1="leg1_servo_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg1_servo_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg2_distal_link" link2="leg2_proximal_link" reason="Adjacent"/>
  <disable_collisions link1="leg2_distal_link" link2="leg2_servo_link" reason="Never"/>
  <disable_collisions link1="leg2_distal_link" link2="leg3_distal_link" reason="Never"/>
  <disable_collisions link1="leg2_distal_link" link2="leg3_proximal_link" reason="Never"/>
  <disable_collisions link1="leg2_distal_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg2_distal_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg2_proximal_link" link2="leg2_servo_link" reason="Never"/>
  <disable_collisions link1="leg2_proximal_link" link2="leg3_distal_link" reason="Never"/>
  <disable_collisions link1="leg2_proximal_link" link2="leg3_proximal_link" reason="Never"/>
  <disable_collisions link1="leg2_proximal_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg2_proximal_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg2_servo_link" link2="leg3_distal_link" reason="Never"/>
  <disable_collisions link1="leg2_servo_link" link2="leg3_proximal_link" reason="Never"/>
  <disable_collisions link1="leg2_servo_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg2_servo_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg3_distal_link" link2="leg3_proximal_link" reason="Adjacent"/>
  <disable_collisions link1="leg3_distal_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg3_distal_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg3_proximal_link" link2="leg3_servo_link" reason="Never"/>
  <disable_collisions link1="leg3_proximal_link" link2="platform_link" reason="Never"/>
  <disable_collisions link1="leg3_servo_link" link2="platform_link" reason="Never"/>
</robot>
