<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pm3rrr_core</name>
  <version>1.0.0</version>
  <description>ROS-independent kinematics, dynamics, workspace, trajectory and IMU models of the planar 3-RRR parallel manipulator.</description>
  <maintainer email="basheeraltaweel@gmail.com">Basheer Altawil</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
